# ==================================================
# PERSONAL AI OPERATING ASSISTANT CONFIGURATION
# ==================================================

# 1. Telegram Bot Credentials
# Get your bot token from Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your numeric user ID from https://t.me/userinfobot to secure the bot whitelist
TELEGRAM_ALLOWED_USER_ID=0

# 2. AI Model Provider Settings
# Options: "gemini" | "groq" | "openrouter" | "ollama" | "mock"
AI_PROVIDER=gemini

# Free Google AI Studio API Key from https://aistudio.google.com/
AI_API_KEY=your_gemini_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.0-flash

# 3. Persistent Database Path
DATABASE_PATH=./data/assistant.db

# 4. Schedule Anchors (24-Hour Format)
USER_COLLEGE_RETURN_TIME=19:30
USER_DINNER_TIME=21:30
USER_DEEP_WORK_START=23:00
USER_SLEEP_TIME=04:30
